rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile Rules - Strictly scoped to the authenticated owner
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Workouts - Strictly owned by the user
    match /workouts/{workoutId} {
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }

    // Training Plans - Owned by the athlete or assigned coach
    match /training_plans/{planId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || 
         ('coachId' in resource.data && resource.data.coachId == request.auth.uid));
    }

    // Coach Requests - Readable/Updatable by the requester or matched coach
    match /coach_requests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || 
         ('matchedCoachId' in resource.data && resource.data.matchedCoachId == request.auth.uid));
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Performance Snapshots - Strictly private to the user
    match /performance_snapshots/{snapshotId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
