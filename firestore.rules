rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole(userId) {
      let doc = get(/databases/$(database)/documents/users/$(userId));
      return doc.data().role;
    }

    function isCoach() {
      return isAuthenticated() && getUserRole(request.auth.uid) == 'coach';
    }

    function isAthlete() {
      return isAuthenticated() && getUserRole(request.auth.uid) == 'athlete';
    }

    function isAssignedCoachOf(athleteId) {
      return isCoach() &&
        exists(/databases/$(database)/documents/coach_athletes/$(athleteId)) &&
        /databases/$(database)/documents/coach_athletes/$(athleteId).data().coachId == request.auth.uid;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAssignedCoachOf(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) &&
        (!('id' in request.resource.data) || request.resource.data.id == userId);
      allow delete: if false;
    }

    // Workouts - Strictly owned by the user
    match /workouts/{workoutId} {
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) ||
        isAssignedCoachOf(resource.data.userId);
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Training Plans - Owned by the athlete or assigned coach
    match /training_plans/{planId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isOwner(resource.data.userId) ||
        isAssignedCoachOf(resource.data.userId) ||
        (isAuthenticated() &&
         ('coachId' in resource.data && resource.data.coachId == request.auth.uid));
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         ('coachId' in resource.data && resource.data.coachId == request.auth.uid)) &&
        request.resource.data.userId == resource.data.userId;
    }

    // Coach Requests - Readable/Updatable by the requester or matched coach
    match /coach_requests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         ('matchedCoachId' in resource.data && resource.data.matchedCoachId == request.auth.uid));
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         ('matchedCoachId' in resource.data && resource.data.matchedCoachId == request.auth.uid)) &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Performance Snapshots - Private to the user, readable by assigned coach
    match /performance_snapshots/{snapshotId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) ||
        isAssignedCoachOf(resource.data.userId);
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Coach inquiries - private to the requesting user and selected coach.
    match /coach_inquiries/{inquiryId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.coachId == request.auth.uid);
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.coachId == request.auth.uid) &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Notifications and push tokens are private to the signed-in user.
    match /users/{userId}/notifications/{notificationId} {
      allow read, create: if isOwner(userId);
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/devices/{deviceId} {
      allow read, write: if isOwner(userId);
    }

    // User preferences - strictly private to the owner
    match /users/{userId}/preferences/{docId} {
      allow read, write: if isOwner(userId);
    }

    // Event catalog is public to authenticated users; ticket ownership is strict.
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /tickets/{ticketId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Social activity feed — readable by all signed-in users (global feed),
    // creations owned; updates open to signed-in users for kudos/comment counters.
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() &&
          resource.data.userId == request.auth.uid;
      }
    }

    // Gear vault — strictly owned by the user.
    match /gear/{gearId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId);
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // Adaptive training recommendations — private to the owner.
    match /users/{userId}/recommendations/{recId} {
      allow read, write: if isOwner(userId);
    }

    // Coach profiles are curated server-side and readable by signed-in athletes.
    match /coaches/{coachId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Coach-athlete assignments — readable by both parties, writable by coach.
    match /coach_athletes/{athleteId} {
      allow create: if isCoach();
      allow read: if (isCoach() && resource.data.coachId == request.auth.uid) ||
        (isAthlete() && resource.data.userId == request.auth.uid);
      allow update: if isCoach() && resource.data.coachId == request.auth.uid;
      allow delete: if isCoach() && resource.data.coachId == request.auth.uid;

      // Per-athlete training summaries (populated by backend jobs).
      match /summary/{summaryId} {
        allow read: if (isCoach() && get(/databases/$(database)/documents/coach_athletes/$(athleteId)).data().coachId == request.auth.uid) ||
          (isAthlete() && get(/databases/$(database)/documents/coach_athletes/$(athleteId)).data().userId == request.auth.uid);
        allow write: if false;
      }
    }

    // Chat rooms — readable/writable by participants (athlete and coach).
    match /chat_rooms/{chatRoomId} {
      allow read: if isAuthenticated() &&
        (resource.data.athleteId == request.auth.uid ||
         resource.data.coachId == request.auth.uid);
      allow create: if isAuthenticated() &&
        (request.resource.data.athleteId == request.auth.uid ||
         (isCoach() && request.resource.data.coachId == request.auth.uid));
      allow update: if isAuthenticated() &&
        (resource.data.athleteId == request.auth.uid ||
         resource.data.coachId == request.auth.uid);
      allow delete: if false;

      // Messages within a chat room
      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          (get(/databases/$(database)/documents/chat_rooms/$(chatRoomId)).data().athleteId == request.auth.uid ||
           get(/databases/$(database)/documents/chat_rooms/$(chatRoomId)).data().coachId == request.auth.uid);
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated() &&
          (get(/databases/$(database)/documents/chat_rooms/$(chatRoomId)).data().athleteId == request.auth.uid ||
           get(/databases/$(database)/documents/chat_rooms/$(chatRoomId)).data().coachId == request.auth.uid);
        allow delete: if false;
      }
    }
  }
}
